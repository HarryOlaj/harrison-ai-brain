# Copy to config/jimmy-link.env and fill values.
# chmod 600 config/jimmy-link.env

# SSH tunnel settings
TUNNEL_NAME="jimmy-harry"
SSH_USER="jimmy"
SSH_HOST="example.com"
SSH_PORT="22"
LOCAL_PORT="8787"
REMOTE_HOST="127.0.0.1"
REMOTE_PORT="8787"
SSH_KEY_PATH="$HOME/.ssh/id_ed25519"
SSH_OPTS="-o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o ExitOnForwardFailure=yes -o StrictHostKeyChecking=accept-new"

# Jimmy node host
NODE_HOST_NAME="jimmy-node-host"
NODE_BIN="/opt/homebrew/bin/node"
NODE_ENTRY="$HOME/jimmy/node-host/index.js"
WORKDIR="$HOME/jimmy/node-host"
GATEWAY_TOKEN="REPLACE_ME"
GATEWAY_URL="http://127.0.0.1:8787"

# Gate B truth-check endpoint/action
GATE_B_CHECK_URL="http://127.0.0.1:8787/healthz"
GATE_B_TIMEOUT_SEC="5"

# Alerts (optional)
DISCORD_WEBHOOK_URL=""
ALERT_PREFIX="[JimmyLink]"

# Watchdog tuning
MAX_RESTART_ATTEMPTS="3"
STATE_DIR="$HOME/.jimmy-link/state"
LOG_DIR="$HOME/.jimmy-link/logs"
